# ─── Binance TH API credentials ────────────────────────────────────────────
# Create at https://www.binance.th  →  Account  →  API Management
# READ-ONLY permissions are enough. Do NOT enable trading or withdrawals.
BINANCE_TH_API_KEY=your_api_key_here
BINANCE_TH_API_SECRET=your_api_secret_here

# ─── Connection ────────────────────────────────────────────────────────────
# Leave blank to auto-detect. Override if Binance TH changes hosts.
# BINANCE_TH_BASE_URL=https://api.binance.th
# Force an API dialect instead of auto-detecting: openv1 | apiv3
# BINANCE_TH_DIALECT=openv1
BINANCE_TH_RECV_WINDOW=10000

# ─── Portfolio behaviour ───────────────────────────────────────────────────
# Currency the dashboard headlines. THB or USDT (you can flip it in the UI too).
BASE_CURRENCY=THB
# Cost-basis method: fifo | avg   (fifo matches Thai capital-gains convention)
COST_BASIS_METHOD=fifo
# How the THB cost of a USDT-quoted buy is derived:
#   lots   = trace the actual THB you paid for those USDT (most accurate)
#   market = use the USDTTHB market rate at the moment of the trade
FX_MODE=lots
# Count crypto withdrawals as a disposal (realises PnL) or a plain transfer out
TREAT_WITHDRAWAL_AS_SALE=false

# ─── Runtime ───────────────────────────────────────────────────────────────
DB_PATH=data/portfolio.db
PRICE_REFRESH_SECONDS=5
HOST=127.0.0.1
PORT=8787
